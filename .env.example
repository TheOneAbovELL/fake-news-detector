# Copy to .env and fill in. Never commit .env.
# Format: KEY=value (no "set"/"export" prefix, no quotes needed).

# ── Optional: Groq LLM layer ──────────────────────────────────────────────
# Without a key TruthLens runs on the ML model only. Get one at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT=20
# GROQ_MAX_RETRIES=1

# ── Server ────────────────────────────────────────────────────────────────
# PORT=5000                 # dev server (python app.py)
# HOST=127.0.0.1            # dev server bind address
# LOG_LEVEL=INFO
# RATE_LIMIT_PER_MINUTE=30  # per client IP, per process; 0 disables
# TRUST_PROXY=false         # true when behind a reverse proxy that sets X-Forwarded-For
# MAX_TEXT_CHARS=5000
# MODELS_DIR=models

# ── URL fetching ──────────────────────────────────────────────────────────
# SCRAPE_TIMEOUT=10
# SCRAPE_MAX_BYTES=3000000
# ALLOW_PRIVATE_URLS=false  # NEVER enable in production (allows fetching internal hosts)
